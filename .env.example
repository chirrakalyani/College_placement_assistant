# MongoDB Atlas Connection URI (Replace with your actual MongoDB Atlas cluster connection string)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/college_placement?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/college_placement?retryWrites=true&w=majority

# JWT Secret for authentication tokens
JWT_SECRET=college_placement_assistant_secret_jwt_key_2026_nit

# Server Port (Default is 5000)
PORT=5000

# Environment mode
NODE_ENV=development
