{
  "name": "college-placement-assistant-ai",
  "version": "1.0.0",
  "description": "Full-stack MERN College Placement Assistant AI platform",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "build": "cd client && npm install && npm run build && node -e \"const fs=require('fs'); try{fs.cpSync('client/dist', 'dist', {recursive:true})}catch(e){}\""
  },
  "keywords": [
    "mern",
    "placement-assistant",
    "campus-recruitment",
    "resume-ats",
    "interview-ai",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
